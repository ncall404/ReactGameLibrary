{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
	"allowImportingTsExtensions": true,//this works only with below noEmit set to true
  	"noEmit": true,
  },
  "exclude": ["node_modules"]
}
